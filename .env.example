NEXT_PUBLIC_SOLANA_NETWORK=mainnet   # mainnet | devnet | testnet -- this project currently runs on mainnet

SOLANA_RPC_MAINNET=https://sol.rpcfast.com/?api_key=API_KEY
SOLANA_RPC_DEVNET=https://api.devnet.solana.com/
SOLANA_RPC_TESTNET=https://api.testnet.solana.com/

# Panta (server-side only). Use a pk_live_ key for real data.
PANTA_API_KEY=pk_live_xxx
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# Optional: an image URL verified to pass Panta's quote AND build steps
PANTA_DEFAULT_IMAGE_URL=
