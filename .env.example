# ─────────────────────────────────────────────────────────────
# Network switch: mainnet | devnet | testnet   (unset = devnet, the safe default)
# IMPORTANT: NEXT_PUBLIC_ values are baked in at BUILD time. On Vercel, set this before
# deploying and redeploy after changing it.
# Panta's API builds MAINNET transactions, so creating Panta markets needs mainnet.
# Meteora launches + trading work on mainnet + devnet; testnet only if DBC is deployed
# there (check /status -> "Meteora DBC program deployed on this network").
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=mainnet   # mainnet | devnet | testnet -- this project currently runs on mainnet

# RPC Fast endpoints. SERVER-SIDE ONLY (no NEXT_PUBLIC_): the browser talks to /api/rpc,
# which relays to these, so your key is never shipped to users and origin/domain
# restrictions on the key can't cause 403s.
SOLANA_RPC_MAINNET=https://your-rpc-fast-mainnet-url    # required for mainnet (active)
SOLANA_RPC_DEVNET=https://your-rpc-fast-devnet-url       # kept working for local/dev testing
SOLANA_RPC_TESTNET=https://your-rpc-fast-testnet-url     # kept working; DBC deployment there is checked at /status
# (If a devnet/testnet URL is omitted, the matching public RPC is used.)

# Panta (server-side only). Use a pk_live_ key for real data.
PANTA_API_KEY=pk_live_xxx
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# Optional: an image URL verified to pass Panta's quote AND build steps
PANTA_DEFAULT_IMAGE_URL=

# Optional: expose /api/panta/discover in production (dev-only by default)
# DEBUG_ROUTES=1
