# RPC Fast (all Solana reads/writes go through this). Point at devnet to test launches without real SOL.
NEXT_PUBLIC_RPC_ENDPOINT=https://your-rpc-fast-endpoint.com

# Panta (server-side only -- never prefix with NEXT_PUBLIC_). Use a pk_live_ key for real data.
PANTA_API_KEY=pk_live_xxx
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# Optional: an image URL you have verified passes Panta's quote AND build steps
PANTA_DEFAULT_IMAGE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
